# ==========================================================
# DermaWise - Git Ignore
# ==========================================================

# --------------------------
# Python
# --------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
Backend/venv/

# Python tooling / caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --------------------------
# Next.js / Node.js
# --------------------------
node_modules/
frontend-app/node_modules/

.next/
frontend-app/.next/

out/
dist/
build/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------
# Environment / secrets
# --------------------------
.env
.env.*
!.env.example

# --------------------------
# IDE / Editor
# --------------------------
.vscode/
.idea/

# --------------------------
# Operating system
# --------------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------------
# Temporary files
# --------------------------
*.tmp
*.temp
*.log
*.bak

# --------------------------
# Project backups
# --------------------------
main_backup.py
page_backup.tsx

# --------------------------
# Jupyter
# --------------------------
.ipynb_checkpoints/

# --------------------------
# Datasets
# Do not upload large/raw datasets
# --------------------------
data/
dataset/
datasets/

